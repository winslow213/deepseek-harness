{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023"],
    "types": ["node"],
    "strict": true,
    "noImplicitAny": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "outDir": "lib",
    "rootDir": "src"
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    // executor.ts and fs-provider.ts import @deepseek-ai/* packages that only
    // resolve inside a dsh runtime (see tsconfig.executor.json); the standalone
    // shell build excludes them.
    "src/remote/executor.ts",
    "src/remote/fs-provider.ts",
    "src/remote/region-router.ts",
    "src/remote/region-shell.ts",
    "tests",
    "node_modules",
    "lib"
  ]
}
