# Copy to `.env` and fill in real values. `npm start` / `npm run account`
# read it via `node --env-file-if-exists=.env`. Never commit `.env`.

# --- required (account service) ---
# PostgreSQL connection (dsh_users / dsh_instances live here).
TEAM_DB_URL=postgres://postgres:CHANGE_ME@127.0.0.1:5432/postgres
# Redis connection (login sessions).
TEAM_REDIS_URL=redis://127.0.0.1:6380/0

# --- optional (account service, defaults shown) ---
# Loopback port the account HTTP API listens on.
#TEAM_HTTP_PORT=3900
# Login-session TTL in seconds (default 30 days).
#TEAM_SESSION_TTL_SECS=2592000
# Base64url length of issued agent tokens (>= 16; default 32 = 256 bits).
#TEAM_AGENT_TOKEN_BYTES=32
# Pairing-code TTL in seconds (default 30 minutes; one code mounts several devices).
#TEAM_PAIRING_TTL_SECS=1800
# Idle timeout in seconds after which a member's instance is reclaimed
# (default 30 minutes). The proxy refreshes activity on every request, so an
# active session never crosses the threshold; a lapsed session is reclaimed on
# the next sweep and cold-starts on the next login.
#TEAM_IDLE_TIMEOUT_SECS=1800
# Team-wide LLM facts injected into every spawned instance via the home-level
# cordis patch (`$DSH_HOME/cordis.patch.yml`). The key is never written to any
# file: the patch points `llm-deepseek` at the DSH_LLM_API_KEY credential
# reference and the DSH_LLM_BASE_URL endpoint, both inherited by the child from
# these values. Change here and restart instances to propagate to every user.
#TEAM_LLM_API_KEY=
#TEAM_LLM_BASE_URL=https://your-router.example.com/api/llmrouter
# Shared secret presented on instance-registration and pairing-claim calls
# (operator-side). Leave empty to trust loopback-only.
#TEAM_ADMIN_SECRET=
# Inclusive loopback port range for per-user instances.
#TEAM_INSTANCE_PORT_START=32001
#TEAM_INSTANCE_PORT_END=60999

# --- per-user instance spawn (read directly by spawn-user) ---
# Per-user DSH_HOME root: <DSH_USERS_ROOT>/<user>.
DSH_USERS_ROOT=/home/winslow/.dsh-users
# LAN host the spawned dsh instances trust (the proxy entry address).
DSH_ENTRY_HOST=10.33.2.56
# Hub control port the region routers + mount-sync relay to (loopback).
#DSH_HUB_CONTROL_PORT=7100
# Hub shadow root the region routers and mount-sync agree on.
#DSH_SHADOW_ROOT=/tmp/dsh-shadow
